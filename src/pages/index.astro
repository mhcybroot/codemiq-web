---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Codemiq | Official Software Studio & bdHousing Marketplace">
  <!-- Hero Section -->
  <section class="relative overflow-hidden pt-12 pb-20 md:py-24 border-b border-slate-900">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-emerald-900/20 via-slate-950 to-slate-950 -z-10"></div>
    <div class="max-w-6xl mx-auto px-4 sm:px-6 text-center">
      
      <!-- Trust Badge -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-950/80 border border-emerald-700/40 text-emerald-300 text-xs font-semibold mb-6 shadow-sm">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>Google Play Verified Organization • D-U-N-S® 732333260</span>
      </div>

      <h1 class="text-3xl sm:text-5xl md:text-6xl font-extrabold tracking-tight text-white max-w-4xl mx-auto leading-tight md:leading-tight mb-6">
        Building Verified Digital Platforms & <span class="bg-gradient-to-r from-emerald-400 via-teal-300 to-green-400 bg-clip-text text-transparent">Trusted Mobile Solutions</span>
      </h1>

      <p class="text-base sm:text-lg text-slate-400 max-w-2xl mx-auto mb-10 leading-relaxed font-normal">
        Codemiq (Miyaji Traders) বাংলাদেশে প্রযুক্তিগত নিরাপত্তা, স্বচ্ছতা এবং নির্ভরযোগ্য সেবা প্রদানে নিবেদিত। আমাদের ফ্ল্যাগশিপ মোবাইল প্ল্যাটফর্ম <strong>bdHousing</strong> জমি ও ফ্ল্যাট কেনাবেচায় এনেছে ডিজিটাল বিপ্লব।
      </p>

      <!-- Action Buttons -->
      <div class="flex flex-wrap items-center justify-center gap-4">
        <a href="#products" class="px-6 py-3.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-sm transition-all shadow-lg shadow-emerald-950/60 inline-flex items-center gap-2">
          <span>bdHousing প্রজেক্ট দেখুন</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
        </a>
        <a href="#about" class="px-6 py-3.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-200 border border-slate-700 font-semibold text-sm transition-all inline-flex items-center gap-2">
          <span>আমাদের সম্পর্কে</span>
        </a>
      </div>

      <!-- Quick Trust Indicators -->
      <div class="mt-14 pt-8 border-t border-slate-900 grid grid-cols-2 sm:grid-cols-4 gap-4 max-w-3xl mx-auto text-left">
        <div class="p-3 bg-slate-900/40 rounded-lg border border-slate-800/60">
          <div class="text-xs text-slate-400">প্রতিষ্ঠান</div>
          <div class="text-sm font-bold text-slate-200">MIYAJI TRADERS</div>
        </div>
        <div class="p-3 bg-slate-900/40 rounded-lg border border-slate-800/60">
          <div class="text-xs text-slate-400">নিবন্ধন নম্বর</div>
          <div class="text-sm font-bold text-slate-200">Trade License #179</div>
        </div>
        <div class="p-3 bg-slate-900/40 rounded-lg border border-slate-800/60">
          <div class="text-xs text-slate-400">D-U-N-S গ্লোবাল আইডি</div>
          <div class="text-sm font-bold text-emerald-400 font-mono">732333260</div>
        </div>
        <div class="p-3 bg-slate-900/40 rounded-lg border border-slate-800/60">
          <div class="text-xs text-slate-400">হেড অফিস</div>
          <div class="text-sm font-bold text-slate-200">সদর, নোয়াখালী</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Flagship Product Section: bdHousing -->
  <section id="products" class="py-20 bg-slate-900/30 border-b border-slate-900">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
        <div>
          <span class="text-xs font-bold text-emerald-400 tracking-wider uppercase mb-1 block">Featured Mobile App</span>
          <h2 class="text-2xl sm:text-4xl font-extrabold text-white tracking-tight">
            bdHousing - জমি ও ফ্ল্যাট মার্কেটপ্লেস
          </h2>
        </div>
        <p class="text-sm text-slate-400 max-w-md mt-2 md:mt-0 leading-relaxed">
          বাংলাদেশের জমি ও রিয়েল এস্টেট খাতে সর্বোচ্চ স্বচ্ছতা, বিশ্বস্ততা ও মাঠ পর্যায়ের নিরাপত্তা নিশ্চিত করার বিশেষায়িত মোবাইল অ্যাপ।
        </p>
      </div>

      <!-- Product Feature Card -->
      <div class="bg-gradient-to-b from-slate-900 to-slate-950 rounded-2xl border border-slate-800 p-6 sm:p-10 shadow-2xl">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
          
          <div class="lg:col-span-7 space-y-6">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-emerald-950 text-emerald-400 text-xs font-semibold border border-emerald-800/50">
              <span>ভার্সন 1.0.1 (Build 2) • Android 7.0+ (API 24-36)</span>
            </div>

            <h3 class="text-xl sm:text-2xl font-bold text-white">
              নিরাপদ জমি ও ফ্ল্যাট কেনাবেচার সমন্বিত ডিজিটাল ইকোসিস্টেম
            </h3>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="p-4 rounded-xl bg-slate-950 border border-slate-800/80">
                <div class="w-8 h-8 rounded-lg bg-emerald-950 text-emerald-400 flex items-center justify-center font-bold text-sm mb-2.5">১</div>
                <h4 class="font-bold text-white text-sm mb-1">যাচাইকৃত প্রোপার্টি লিস্টিং</h4>
                <p class="text-xs text-slate-400 leading-relaxed">মৌজা ও বায়া খতিয়ান ক্রস-ভেরিফিকেশন এবং ফিল্ড ইন্সপেকশন সম্পন্ন করা প্রোপার্টি।</p>
              </div>

              <div class="p-4 rounded-xl bg-slate-950 border border-slate-800/80">
                <div class="w-8 h-8 rounded-lg bg-emerald-950 text-emerald-400 flex items-center justify-center font-bold text-sm mb-2.5">২</div>
                <h4 class="font-bold text-white text-sm mb-1">প্রবাসী ভাইদের বিশেষ সেবা</h4>
                <p class="text-xs text-slate-400 leading-relaxed">প্রবাসীদের জমি-জমা দেখভাল, ক্রয়-বিক্রয় ও পাওয়ার অব অ্যাটর্নির আইনি সহায়তা।</p>
              </div>

              <div class="p-4 rounded-xl bg-slate-950 border border-slate-800/80">
                <div class="w-8 h-8 rounded-lg bg-emerald-950 text-emerald-400 flex items-center justify-center font-bold text-sm mb-2.5">৩</div>
                <h4 class="font-bold text-white text-sm mb-1">স্মার্ট বাজেট ও এরিয়া ফিল্টার</h4>
                <p class="text-xs text-slate-400 leading-relaxed">শতাংশ/কাঠা এবং সর্বোচ্চ বাজেট অনুযায়ী তাৎক্ষণিক প্রোপার্টি অনুসন্ধান।</p>
              </div>

              <div class="p-4 rounded-xl bg-slate-950 border border-slate-800/80">
                <div class="w-8 h-8 rounded-lg bg-emerald-950 text-emerald-400 flex items-center justify-center font-bold text-sm mb-2.5">৪</div>
                <h4 class="font-bold text-white text-sm mb-1">সরাসরি ক্রেতা-বিক্রেতা ডিল</h4>
                <p class="text-xs text-slate-400 leading-relaxed">কোনো মধ্যস্বত্বভোগী বা ভুয়া এসক্রো ছাড়া সরাসরি বৈধ আইনি রেজিস্ট্রেশন।</p>
              </div>
            </div>

            <!-- Google Play Status -->
            <div class="pt-2 flex flex-wrap items-center gap-3">
              <div class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-slate-900 border border-slate-700/80 text-emerald-400 font-semibold text-xs sm:text-sm">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M3.609 1.814L13.792 12 3.61 22.186a2.03 2.03 0 0 1-.61-1.46V3.274c0-.57.228-1.096.609-1.46zm11.602 11.604l2.095 2.095-11.45 6.444 9.355-8.539zm0-2.836L5.856 2.043l11.45 6.444-2.095 2.095zm1.418 1.418l3.666 2.062c1.02.574 1.02 1.512 0 2.086l-3.666 2.062-2.122-2.122 2.122-2.088z"/></svg>
                <span>Google Play স্টোর রিলিজ শীঘ্রই আসছে</span>
              </div>
            </div>
          </div>

          <div class="lg:col-span-5 flex justify-center">
            <div class="relative w-64 sm:w-72 rounded-[2.5rem] p-3 bg-gradient-to-b from-slate-700 to-slate-900 shadow-2xl border-4 border-slate-800">
              <div class="rounded-[2rem] overflow-hidden bg-slate-950 shadow-inner aspect-[9/19]">
                <img src="/images/screenshots/01_home_marketplace.png" alt="bdHousing App Marketplace Screen" class="w-full h-full object-cover" />
              </div>
            </div>
          </div>

        </div>
      </div>

      <!-- App Screenshots Gallery -->
      <div class="mt-16">
        <h3 class="text-lg font-bold text-white mb-6">অ্যাপের বিভিন্ন ইন্টারফেস স্ক্রিনশট</h3>
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-3">
          <div class="rounded-xl overflow-hidden border border-slate-800 bg-slate-900/50">
            <img src="/images/screenshots/01_home_marketplace.png" alt="Home Screen" class="w-full aspect-[9/19] object-cover" />
            <div class="p-2 text-[11px] text-center font-medium text-slate-300">মার্কেটপ্লেস ফিড</div>
          </div>
          <div class="rounded-xl overflow-hidden border border-slate-800 bg-slate-900/50">
            <img src="/images/screenshots/02_buyer_demands.png" alt="Buyer Demands" class="w-full aspect-[9/19] object-cover" />
            <div class="p-2 text-[11px] text-center font-medium text-slate-300">ক্রেতার চাহিদা</div>
          </div>
          <div class="rounded-xl overflow-hidden border border-slate-800 bg-slate-900/50">
            <img src="/images/screenshots/03_rules_and_safety.png" alt="Rules & Safety" class="w-full aspect-[9/19] object-cover" />
            <div class="p-2 text-[11px] text-center font-medium text-slate-300">নিরাপত্তা নীতিমালা</div>
          </div>
          <div class="rounded-xl overflow-hidden border border-slate-800 bg-slate-900/50">
            <img src="/images/screenshots/04_login_and_auth.png" alt="Login & Security" class="w-full aspect-[9/19] object-cover" />
            <div class="p-2 text-[11px] text-center font-medium text-slate-300">লগইন ও প্রোফাইল</div>
          </div>
          <div class="rounded-xl overflow-hidden border border-slate-800 bg-slate-900/50">
            <img src="/images/screenshots/05_admin_management_panel.png" alt="Agent Workspace" class="w-full aspect-[9/19] object-cover" />
            <div class="p-2 text-[11px] text-center font-medium text-slate-300">প্রতিনিধি প্যানেল</div>
          </div>
          <div class="rounded-xl overflow-hidden border border-slate-800 bg-slate-900/50">
            <img src="/images/screenshots/06_verified_properties_feed.png" alt="Verified Properties" class="w-full aspect-[9/19] object-cover" />
            <div class="p-2 text-[11px] text-center font-medium text-slate-300">যাচাইকৃত সম্পত্তি</div>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- About Organization Section -->
  <section id="about" class="py-20 border-b border-slate-900">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-12 items-center">
        
        <div class="md:col-span-6 space-y-4">
          <span class="text-xs font-bold text-emerald-400 tracking-wider uppercase block">About Our Organization</span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-white">
            Codemiq (Miyaji Traders)
          </h2>
          <p class="text-sm text-slate-300 leading-relaxed">
            Codemiq হলো নোয়াখালীতে নিবন্ধিত বাণিজ্যিক প্রতিষ্ঠান <strong>MIYAJI TRADERS</strong>-এর অফিশিয়াল ডিজিটাল ও সফটওয়্যার ইনিশিয়েটিভ। আমরা প্রযুক্তিগত উদ্ভাবনের মাধ্যমে সাধারণ নাগরিক ও প্রবাসীদের রিয়েল এস্টেট লেনদেনকে নির্ঝঞ্ঝাট ও নিরাপদ করতে কাজ করছি।
          </p>
          <div class="space-y-2 text-xs text-slate-400 pt-2">
            <div class="flex items-start gap-2">
              <span class="text-emerald-400 font-bold">✓</span>
              <span><strong>D-U-N-S® রেজিস্টার্ড:</strong> Dun & Bradstreet কর্তৃক আন্তর্জাতিকভাবে ভেরিফাইড (D-U-N-S #732333260)।</span>
            </div>
            <div class="flex items-start gap-2">
              <span class="text-emerald-400 font-bold">✓</span>
              <span><strong>বৈধ ট্রেড লাইসেন্স:</strong> নোয়াখালী সদর ইউনিয়ন পরিষদ নিবন্ধিত প্রফেশনাল ও বিজনেস ট্রেড লাইসেন্স নং ১৭৯।</span>
            </div>
            <div class="flex items-start gap-2">
              <span class="text-emerald-400 font-bold">✓</span>
              <span><strong>গুগল প্লে পলিসি কমপ্লায়েন্স:</strong> ব্যবহারকারীর ডেটা নিরাপত্তা, স্বচ্ছতা ও গোপনীয়তা রক্ষায় শতভাগ প্রতিশ্রুতিবদ্ধ।</span>
            </div>
          </div>
        </div>

        <div class="md:col-span-6">
          <div class="p-6 sm:p-8 rounded-2xl bg-slate-900/60 border border-slate-800 space-y-4">
            <h3 class="text-base font-bold text-white mb-2">প্রাতিষ্ঠানিক তথ্যাবলী</h3>
            
            <div class="space-y-3 text-xs divide-y divide-slate-800">
              <div class="pt-2 flex justify-between">
                <span class="text-slate-400">প্রতিষ্ঠান নাম:</span>
                <span class="font-semibold text-slate-200">MIYAJI TRADERS</span>
              </div>
              <div class="pt-3 flex justify-between">
                <span class="text-slate-400">ডিজিটাল ব্র্যান্ড:</span>
                <span class="font-semibold text-emerald-400">Codemiq</span>
              </div>
              <div class="pt-3 flex justify-between">
                <span class="text-slate-400">ট্রেড লাইসেন্স নং:</span>
                <span class="font-semibold text-slate-200">179 (Valid until 30 June 2027)</span>
              </div>
              <div class="pt-3 flex justify-between">
                <span class="text-slate-400">D-U-N-S Number:</span>
                <span class="font-mono text-emerald-400 font-semibold">732333260</span>
              </div>
              <div class="pt-3 flex justify-between">
                <span class="text-slate-400">দায়িত্বপ্রাপ্ত প্রতিনিধি:</span>
                <span class="font-semibold text-slate-200">Md Mozahidul Islam</span>
              </div>
              <div class="pt-3 flex justify-between">
                <span class="text-slate-400">ঠিকানা:</span>
                <span class="font-semibold text-slate-200 text-right">Babul Market, Sadar, Noakhali, BD</span>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Contact Section -->
  <section id="contact" class="py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
      <span class="text-xs font-bold text-emerald-400 tracking-wider uppercase mb-1 block">Get in Touch</span>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-white mb-4">আমাদের সাথে যোগাযোগের মাধ্যম</h2>
      <p class="text-sm text-slate-400 max-w-xl mx-auto mb-10">
        bdHousing অ্যাপ বা প্রাতিষ্ঠানিক যেকোনো প্রশ্ন, সহায়তা বা সহযোগিতার জন্য আমাদের সাথে সরাসরি যোগাযোগ করুন।
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 text-left">
        <div class="p-6 rounded-xl bg-slate-900 border border-slate-800">
          <div class="w-10 h-10 rounded-lg bg-emerald-950 text-emerald-400 flex items-center justify-center mb-4">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
          </div>
          <h4 class="font-bold text-white text-sm mb-1">ইমেইল করুন</h4>
          <p class="text-xs text-slate-400 mb-2">যে কোনো অফিসিয়াল যোগাযোগে</p>
          <a href="mailto:support@mhr.bd" class="text-xs text-emerald-400 font-semibold hover:underline block">support@mhr.bd</a>
          <a href="mailto:codemiq.suite@gmail.com" class="text-xs text-slate-400 hover:underline block mt-0.5">codemiq.suite@gmail.com</a>
        </div>

        <div class="p-6 rounded-xl bg-slate-900 border border-slate-800">
          <div class="w-10 h-10 rounded-lg bg-emerald-950 text-emerald-400 flex items-center justify-center mb-4">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
          </div>
          <h4 class="font-bold text-white text-sm mb-1">সরাসরি ফোন</h4>
          <p class="text-xs text-slate-400 mb-2">সকাল ৯টা - রাত ৮টা (শনি-বৃহস্পতি)</p>
          <a href="tel:+8801410749454" class="text-xs text-emerald-400 font-semibold hover:underline block">+8801410749454</a>
        </div>

