---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 - Page Not Found | Codemiq">
  <div class="max-w-xl mx-auto px-4 py-24 text-center">
    <div class="text-6xl font-extrabold text-emerald-500 mb-4 font-mono">404</div>
    <h1 class="text-2xl font-bold text-white mb-2">পেজটি খুঁজে পাওয়া যায়নি</h1>
    <p class="text-sm text-slate-400 mb-8">আপনি যে লিংকটিতে প্রবেশ করার চেষ্টা করছেন তা বর্তমানে অনুপলব্ধ বা পরিবর্তিত হয়েছে।</p>
    <a href="/" class="px-6 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-semibold text-sm transition-colors inline-block">
      হোমপেজে ফিরে যান
    </a>
  </div>
</Layout>
