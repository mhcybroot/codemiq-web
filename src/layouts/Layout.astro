---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Codemiq - Official Digital Solutions & App Studio",
  description = "Codemiq (Miyaji Traders) - Engineering verified digital platforms and mobile applications in Bangladesh, including bdHousing marketplace."
} = Astro.props;
---

<!doctype html>
<html lang="bn" class="scroll-smooth bg-slate-950 text-slate-100 antialiased selection:bg-emerald-500 selection:text-white">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/images/app-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <!-- Open Graph / Meta -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/images/feature-graphic.png" />
    <meta name="theme-color" content="#042416" />
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
      body {
        font-family: 'Plus Jakarta Sans', 'Hind Siliguri', sans-serif;
      }
    </style>
  </head>
  <body class="min-h-screen flex flex-col bg-slate-950 text-slate-100">
    <!-- Navigation Bar -->
    <header class="sticky top-0 z-50 backdrop-blur-md bg-slate-950/80 border-b border-slate-800/80">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2.5 group">
          <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-emerald-400 to-emerald-700 p-0.5 shadow-lg shadow-emerald-950/50 flex items-center justify-center">
            <span class="text-white font-extrabold text-lg tracking-wider">C</span>
          </div>
          <div>
            <div class="font-extrabold text-lg tracking-tight text-white group-hover:text-emerald-400 transition-colors">CODEMIQ</div>
            <div class="text-[10px] text-emerald-400 font-semibold tracking-widest uppercase -mt-1">Miyaji Traders</div>
          </div>
        </a>

        <nav class="hidden md:flex items-center gap-7 text-sm font-medium text-slate-300">
          <a href="/#products" class="hover:text-emerald-400 transition-colors">bdHousing অ্যাপ</a>
          <a href="/#about" class="hover:text-emerald-400 transition-colors">প্রতিষ্ঠান পরিচিতি</a>
          <a href="/privacy" class="hover:text-emerald-400 transition-colors">প্রাইভেসি পলিসি</a>
          <a href="/terms" class="hover:text-emerald-400 transition-colors">শর্তাবলী</a>
          <a href="/#contact" class="hover:text-emerald-400 transition-colors">যোগাযোগ</a>
        </nav>

        <div class="flex items-center gap-3">
          <a href="/#contact" class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white text-xs sm:text-sm font-semibold transition-all shadow-md shadow-emerald-900/30">
            <span>যোগাযোগ করুন</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
          </a>
        </div>
      </div>
    </header>

    <!-- Main Content -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-slate-800 bg-slate-900/60 mt-20">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
          <div class="md:col-span-2">
            <div class="flex items-center gap-2.5 mb-3">
              <div class="w-7 h-7 rounded-lg bg-emerald-600 flex items-center justify-center font-bold text-white text-sm">C</div>
              <span class="font-bold text-white tracking-wider text-base">CODEMIQ</span>
            </div>
            <p class="text-sm text-slate-400 leading-relaxed max-w-sm mb-4">
              Codemiq (Miyaji Traders) বাংলাদেশে নির্ভরযোগ্য মোবাইল সফটওয়্যার সল্যুশন ও ভেরিফাইড রিয়েল এস্টেট প্ল্যাটফর্ম ব্যবস্থাপনায় নিবেদিত।
            </p>
            <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-md bg-slate-800/80 border border-slate-700/60 text-xs text-emerald-400 font-mono">
              <span>D-U-N-S®: 732333260</span>
              <span class="text-slate-600">|</span>
              <span>Trade License No. 179</span>
            </div>
          </div>

          <div>
            <h4 class="text-xs font-bold text-slate-200 tracking-wider uppercase mb-3">লিগ্যাল ও পলিসি</h4>
            <ul class="space-y-2 text-sm text-slate-400">
              <li><a href="/privacy" class="hover:text-emerald-400 transition-colors">Privacy Policy</a></li>
              <li><a href="/terms" class="hover:text-emerald-400 transition-colors">Terms of Service</a></li>
              <li><a href="/delete-account" class="hover:text-emerald-400 transition-colors">Delete Account & Data</a></li>
              <li><a href="/#about" class="hover:text-emerald-400 transition-colors">Organization Details</a></li>
            </ul>
          </div>

          <div>
            <h4 class="text-xs font-bold text-slate-200 tracking-wider uppercase mb-3">অফিস ও হেল্পলাইন</h4>
            <div class="space-y-2 text-xs text-slate-400 leading-relaxed">
              <p class="text-slate-300 font-medium">MIYAJI TRADERS</p>
              <p>Babul Market, Sadar, Noakhali - 3800, Bangladesh</p>
              <p class="pt-1"><span class="text-slate-500">Email:</span> <a href="mailto:support@mhr.bd" class="text-emerald-400 hover:underline">support@mhr.bd</a></p>
              <p><span class="text-slate-500">Phone:</span> <a href="tel:+8801410749454" class="text-emerald-400 hover:underline">+8801410749454</a></p>
            </div>
          </div>
        </div>

        <div class="border-t border-slate-800/80 mt-10 pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
          <div>
            © 2026 Codemiq (Miyaji Traders). All rights reserved.
          </div>
          <div class="flex items-center gap-4">
            <span class="text-emerald-500/80">Google Play Verified Developer</span>
            <span>•</span>
            <a href="https://codemiq.mhr.bd" class="hover:text-slate-400">codemiq.mhr.bd</a>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
